{
    "name": "enterprise/cms",
    "description": "Enterprise Website Management System based on ThinkPHP",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "topthink/framework": "^8.0",
        "topthink/think-orm": "^3.0",
        "topthink/think-view": "^2.0",
        "topthink/think-captcha": "^3.0",
        "topthink/think-filesystem": "^2.0"
    },
    "require-dev": {
        "topthink/think-trace": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "app\\": "app/"
        },
        "files": [
            "app/common/functions.php"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "post-autoload-dump": [
            "@php think service:discover"
        ]
    },
    "minimum-stability": "stable"
}
