# ===========================
# 通用忽略规则
# ===========================

# 操作系统文件
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE 和编辑器
.idea/
.vscode/
*.swp
*.swo
*.sublime-workspace
*.sublime-project
.project
.settings/
.classpath
*.iml

# ===========================
# PHP / ThinkPHP 项目
# ===========================

# Composer
backend/vendor/
composer.lock

# 运行时目录
backend/runtime/
!backend/runtime/.gitkeep

# 上传文件
backend/public/uploads/
!backend/public/uploads/.gitkeep

# 环境配置
backend/.env

# 日志文件
*.log

# 缓存文件
*.cache

# ===========================
# Docker
# ===========================

# Docker 数据卷（本地开发）
docker-data/

# ===========================
# 其他
# ===========================

# 临时文件
*.tmp
*.temp
*.bak
*.backup

# 压缩文件
*.zip
*.tar.gz
*.rar

# 测试覆盖率
coverage/
.phpunit.result.cache

# Node (如果有前端构建)
node_modules/
npm-debug.log
yarn-error.log
